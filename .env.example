# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional: The application automatically runs in standalone offline mode if not configured)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server Environment
PORT=3000
NODE_ENV="development"

